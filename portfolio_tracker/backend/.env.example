# Copy to .env and fill in. Safe defaults: nothing trades until you opt in.

# --- Core ---
DATABASE_URL=sqlite:///./portfolio.db
ENABLE_SCHEDULER=true
DISCLOSURE_POLL_HOURS=24
POSITION_SYNC_MINUTES=60

# --- Broker (Alpaca) ---
# Get paper keys at https://alpaca.markets (Paper Trading -> API Keys)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Trading safety controls ---
# DISABLED = never trades | PAPER = simulated | LIVE = real money
TRADING_MODE=DISABLED
# LIVE orders ALSO require this to be true (belt-and-suspenders for real money)
LIVE_CONFIRMED=false
# false = signals wait for you to click Approve; true = auto-submit (still bounded by limits)
AUTO_EXECUTE=false

# Hard risk limits
MAX_ORDER_NOTIONAL=500
MAX_POSITION_PCT=5
MAX_ORDERS_PER_DAY=10
# JSON list, e.g. ["TSLA","GME"]
SYMBOL_DENYLIST=[]
